{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quick Dictionary",
  "identifier": "io.github.tichael.quickdictionary",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Offline dictionary and conjugator, one shortcut away",
    "copyright": "MIT License (code); CC BY-SA 4.0 (dictionary data)"
  }
}
